# Plytix product catalogue export — api/export-products.php
#
# Copy to .env for local development:   cp .env.example .env
# On the live server this file is written to /var/www/.env by the deploy
# workflow, one level ABOVE the web root.
#
# ---------------------------------------------------------------------------
# WHERE THIS FILE LIVES MATTERS
#
# The repository root is the web root (index.html is served from it), so a .env
# kept next to index.html is reachable at https://your-host/.env unless nginx
# is told otherwise. The script therefore looks one level above the web root
# first. If you do keep a .env inside the web root, deny it in nginx:
#
#   location ~ /\.(?!well-known) { deny all; return 404; }
#
# Real environment variables always take precedence over this file.
# ---------------------------------------------------------------------------

# Required — Plytix > Profile > Settings > API > Create API key
PLYTIX_API_KEY=
PLYTIX_API_PASSWORD=

# Optional — the Plytix attribute holding the product name
#PLYTIX_NAME_ATTRIBUTE=product_title

# Optional — where the generated catalogue is written
#PLYTIX_OUTPUT_FILE=/var/www/carton-planner/data/products.json

# Optional — point at a mock or sandbox instead of live Plytix
#PLYTIX_AUTH_URL=https://auth.plytix.com/auth/api/get-token
#PLYTIX_PIM_BASE_URL=https://pim.plytix.com
